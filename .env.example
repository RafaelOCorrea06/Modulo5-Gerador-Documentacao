# Gerador-Documentacao - copie para .env e ajuste se preciso.

# --- Integracao IA-Analise (US GD-03 / GD-05) ---
# Local (run-all.ps1 sobe a IA na porta 8001):
IA_ANALISE_URL=http://localhost:8001
IA_ANALISE_TIMEOUT_S=30.0
# "http" = chama o servico real; "fake" = adapter local para testes/dev sem rede.
ADAPTADOR_IA_ANALISE=http

# --- GitHub (US GD-03) ---
GITHUB_API_BASE=https://api.github.com
# GITHUB_TOKEN=                  # opcional - sem token bate em rate limit anonimo
GITHUB_TIMEOUT_S=10.0
ADAPTADOR_GITHUB=http            # "http" ou "fake"

# --- Renderizacao Mermaid (US GD-03) ---
MERMAID_INK_BASE=https://mermaid.ink
MERMAID_TIMEOUT_S=20.0
RENDERIZADOR_MERMAID=ink         # "ink" ou "fake"

# --- Identidade visual Mackenzie (US GD-07) ---
COR_PRIMARIA_MACKENZIE=#9F1B32
COR_SECUNDARIA_MACKENZIE=#2D2D2D
COR_FUNDO_MACKENZIE=#F4F4F4
COR_TEXTO_MACKENZIE=#1A1A1A
NOME_INSTITUICAO=Mackenzie

# --- Persistencia ---
MATRIZ_SQLITE_PATH=gerador_matrizes.db
JOBS_SQLITE_PATH=gerador_jobs.db
ARTEFATOS_DIR=gerador_artefatos
JOBS_TTL_HORAS=24

# ==========================================================================
# Producao / Azure App Service - Modulo5-Gerador-Documentacao
# ==========================================================================
# Setar como "Environment variables / App settings" no Portal do Azure:
#
#   IA_ANALISE_URL=https://modulo5-ia-analise-codigo.azurewebsites.net
#   GITHUB_TOKEN=<PAT do GitHub>     # opcional, recomendado
#
# Sem essa variavel o Gerador tenta chamar http://localhost:8001 dentro do
# container e estoura "Errno 99 Cannot assign requested address" - o que
# aparece como "Gerador respondeu 502" no Interface.
#
# Sem barra "/" no final. Apos Apply, o App Service reinicia sozinho (~30s).
